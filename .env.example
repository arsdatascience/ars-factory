# Ars Factory Configuration
PORT=4001
NODE_ENV=production
LOG_LEVEL=info

# Service Identity
SERVICE_NAME=ars-factory
SERVICE_VERSION=1.0.0

# Optional Redis Connection (for distributed queue / BullMQ)
REDIS_URL=redis://localhost:6379

# Storage Path for Artifacts and Robot Builds
STORAGE_PATH=/app/data/artifacts

# API Security (Optional API Key for protected endpoints)
API_SECRET_TOKEN=change-me-in-production

