# Ars Factory Configuration
PORT=4001
NODE_ENV=production
LOG_LEVEL=info

# Service Identity
SERVICE_NAME=ars-factory
SERVICE_VERSION=1.0.0

# Set a unique URL-safe secret with at least 32 characters.
API_SECRET_TOKEN=

# Optional independent Bearer token limited to GET /metrics.
METRICS_SECRET_TOKEN=

# Required for npm run migrate and npm start outside Compose.
DATABASE_URL=

# Compose only. Use a URL-safe secret.
POSTGRES_PASSWORD=

# Enables simulated tasks and builds. Defaults to read-only.
FACTORY_DEMO_MODE=false

# Optional allowlist for the database host when running migrations.
# FACTORY_MIGRATION_HOSTS=postgres

